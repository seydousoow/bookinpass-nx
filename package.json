{
  "name": "bookinpass",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "front:start": "nx serve front --no-hmr",
    "front:test": "nx test front --coverage",
    "front:lint": "nx lint front",
    "front:build": "nx build front",
    "libs:test": "nx run-many -t test --projects=tag:test -- --coverage",
    "libs:test:ci": "nx run-many -t test --projects=tag:test --tui false -- --coverage",
    "libs:lint": "nx run-many -t lint --projects=tag:lint",
    "libs:lint:ci": "nx run-many -t lint --projects=tag:lint --tui false",
    "libs:build": "nx run-many -t build --projects=tag:build",
    "libs:publish": "nx release publish",
    "all:test": "npm run libs:test && npm run front:test",
    "all:lint": "npm run libs:lint && npm run front:lint",
    "prettier": "prettier --write apps packages"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^22.2.4",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-browser-dynamic": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@jsverse/transloco": "^9.0.0-alpha.4",
    "@jsverse/transloco-locale": "^9.0.0-alpha.4",
    "@jsverse/transloco-messageformat": "^9.0.0-alpha.4",
    "@jsverse/transloco-persist-lang": "^9.0.0-alpha.4",
    "@juristr/nx-tailwind-sync": "^0.0.9",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/heroicons": "^36.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "fuse.js": "^7.5.0",
    "libphonenumber-js": "^1.13.15",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/jest": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/workspace": "^24.0.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-preset-angular": "~17.0.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^3.3.0",
    "nx": "24.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "packageManager": "npm@11.19.0",
  "nx": {
    "targets": {
      "build": {
        "syncGenerators": [
          "@juristr/nx-tailwind-sync:source-directives"
        ]
      },
      "serve": {
        "syncGenerators": [
          "@juristr/nx-tailwind-sync:source-directives"
        ]
      }
    }
  }
}
