{
  "name": "bookinpass",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky",
    "front:start": "nx serve front --no-hmr",
    "front:test": "nx test front --coverage",
    "front:lint": "nx lint front",
    "front:build": "nx build front",
    "bo:start": "nx serve backoffice --no-hmr",
    "bo:test": "nx test backoffice --coverage",
    "bo:lint": "nx lint backoffice",
    "bo:build": "nx build backoffice",
    "libs:test": "nx run-many -t test --projects=tag:kind:library -- --coverage",
    "libs:lint": "nx run-many -t lint --projects=tag:kind:library",
    "libs:build": "nx run-many -t build --projects=tag:kind:library",
    "libs:test:ci": "nx run-many -t test --projects=tag:kind:library --outputStyle=static -- --coverage",
    "libs:lint:ci": "nx run-many -t lint --projects=tag:kind:library --outputStyle=static",
    "libs:build:ci": "nx run-many -t build --projects=tag:kind:library --outputStyle=static",
    "libs:publish": "nx release publish",
    "ci:affected": "nx affected -t lint,test,typecheck,build --base=origin/main --head=HEAD",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "~22.2.7",
    "@angular/cdk": "~22.2.7",
    "@angular/common": "~22.2.6",
    "@angular/compiler": "~22.2.6",
    "@angular/core": "~22.2.6",
    "@angular/forms": "~22.2.6",
    "@angular/platform-browser": "~22.2.6",
    "@angular/router": "~22.2.6",
    "@jsverse/transloco": "^9.0.0-alpha.4",
    "@jsverse/transloco-locale": "^9.0.0-alpha.4",
    "@jsverse/transloco-persist-lang": "^9.0.0-alpha.4",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/heroicons": "^36.1.0",
    "@stripe/stripe-js": "^10.2.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "fuse.js": "^7.5.0",
    "intl-messageformat": "^12.1.5",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.16",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.6",
    "@angular-devkit/schematics": "~22.2.6",
    "@angular/build": "~22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "~22.2.6",
    "@angular/language-service": "~22.2.6",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/jest": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@schematics/angular": "~22.2.6",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jest": "~30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/utils": "^8.72.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "~30.5.2",
    "jest-environment-node": "~30.5.2",
    "jest-preset-angular": "~17.0.3",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.6.0",
    "nx": "24.0.6",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "ts-node": "10.9.2",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1",
    "npm": "^11.20.0"
  },
  "packageManager": "npm@11.21.2",
  "nx": {},
  "lint-staged": {
    "*.{ts,js,mjs,cjs,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,scss,json,md,yml,yaml}": "prettier --write"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.22": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true,
    "nx@24.0.6": true,
    "esbuild@0.28.2": true
  }
}
