{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "components": ["./packages/components/src/index.ts"],
      "components/*": ["./packages/components/src/lib/*"],
      "models": ["./packages/models/src/index.ts"],
      "configs": ["./packages/configurations/src/index.ts"],
      "configs/*": ["./packages/configurations/src/lib/*"],
      "utils": ["./packages/utils/src/index.ts"],
      "utils/*": ["./packages/utils/src/lib/utils/*"],
      "pipes": ["./packages/pipes/src/index.ts"],
      "state": ["./packages/state/src/index.ts"],
      "payment": ["./packages/payment/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
